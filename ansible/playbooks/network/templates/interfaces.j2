# This file is managed by Ansible. Local changes will be overwritten.
# See interfaces(5) for configuration details.

source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

allow-hotplug {{ k8s_network_physical_interface }}
iface {{ k8s_network_physical_interface }} inet manual

auto {{ k8s_network_physical_interface }}.{{ k8s_network_management_vlan }}
iface {{ k8s_network_physical_interface }}.{{ k8s_network_management_vlan }} inet static
    address {{ management_static_ip }}/{{ k8s_network_prefix }}
    gateway {{ k8s_network_management_gateway }}
    dns-nameservers {{ k8s_network_dns_servers | join(' ') }}

auto {{ k8s_network_physical_interface }}.{{ k8s_network_cluster_vlan }}
iface {{ k8s_network_physical_interface }}.{{ k8s_network_cluster_vlan }} inet static
    address {{ kubernetes_static_ip }}/{{ k8s_network_prefix }}

auto {{ k8s_network_physical_interface }}.{{ k8s_network_load_balancer_vlan }}
iface {{ k8s_network_physical_interface }}.{{ k8s_network_load_balancer_vlan }} inet static
    address {{ applications_static_ip }}/{{ k8s_network_prefix }}
{% for route in k8s_network_load_balancer_routes %}
    post-up ip route replace {{ route }} via {{ k8s_network_load_balancer_gateway }} dev {{ k8s_network_physical_interface }}.{{ k8s_network_load_balancer_vlan }}
    pre-down ip route del {{ route }} via {{ k8s_network_load_balancer_gateway }} dev {{ k8s_network_physical_interface }}.{{ k8s_network_load_balancer_vlan }} || true
{% endfor %}

auto {{ k8s_network_physical_interface }}.{{ k8s_network_storage_vlan }}
iface {{ k8s_network_physical_interface }}.{{ k8s_network_storage_vlan }} inet static
    address {{ nfs_static_ip }}/{{ k8s_network_prefix }}

auto {{ k8s_network_physical_interface }}.{{ k8s_network_pv_vlan }}
iface {{ k8s_network_physical_interface }}.{{ k8s_network_pv_vlan }} inet static
    address {{ pv_static_ip }}/{{ k8s_network_prefix }}
